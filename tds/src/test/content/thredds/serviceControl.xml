<?xml version="1.0" encoding="UTF-8"?>
<!-- Datasets with deliberately narrow service declarations, used by PerDatasetServiceControlTest -->
<catalog name="TDS Unit Test Per-Dataset Service Control"
         xmlns="http://www.unidata.ucar.edu/namespaces/thredds/InvCatalog/v1.0"
         xmlns:xlink="http://www.w3.org/1999/xlink" version="1.2">

  <service name="svcHttpOnly" serviceType="HTTPServer" base="/thredds/fileServer/"/>
  <service name="svcOpendapOnly" serviceType="OpenDAP" base="/thredds/dodsC/"/>

  <service name="svcOpendapAndHttp" base="" serviceType="compound">
    <service name="svcCompoundOdap" serviceType="OpenDAP" base="/thredds/dodsC/"/>
    <service name="svcCompoundHttp" serviceType="HTTPServer" base="/thredds/fileServer/"/>
  </service>

  <datasetRoot path="serviceControl" location="content/testdata/"/>

  <!-- declares httpServer only -->
  <dataset name="Service Control - HTTPServer only" ID="serviceControlHttpOnly" serviceName="svcHttpOnly"
           urlPath="serviceControl/testData.nc" dataType="Grid"/>

  <!-- declares opendap only -->
  <dataset name="Service Control - OPeNDAP only" ID="serviceControlOpendapOnly" serviceName="svcOpendapOnly"
           urlPath="serviceControl/testData2.nc" dataType="Grid"/>

  <!-- declares a compound service with both opendap and httpServer -->
  <dataset name="Service Control - Compound" ID="serviceControlCompound" serviceName="svcOpendapAndHttp"
           urlPath="serviceControl/testgrid1.nc" dataType="Grid"/>

  <!-- child inherits serviceName from the parent's inherited metadata -->
  <dataset name="Service Control - Inheritance">
    <metadata inherited="true">
      <serviceName>svcHttpOnly</serviceName>
    </metadata>
    <dataset name="Service Control - Inherited HTTPServer only" ID="serviceControlInherited"
             urlPath="serviceControl/testgrid2.nc" dataType="Grid"/>
  </dataset>

  <!-- every dataset generated by this scan is restricted to opendap -->
  <datasetScan name="Service Control - Scan" ID="serviceControlScan" path="serviceControlScan"
               location="content/testdata/">
    <metadata inherited="true">
      <serviceName>svcOpendapOnly</serviceName>
      <dataType>Grid</dataType>
    </metadata>
    <filter>
      <include wildcard="testData.nc" atomic="true" collection="false"/>
    </filter>
  </datasetScan>

</catalog>
